{
  "name": "@teelabs/tackle",
  "version": "0.1.0",
  "description": "A framework-agnostic RBAC and ABAC authorization engine.",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./express": { "types": "./dist/express.d.ts", "import": "./dist/express.js", "require": "./dist/express.cjs" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js", "require": "./dist/react.cjs" },
    "./drizzle": { "types": "./dist/drizzle.d.ts", "import": "./dist/drizzle.js", "require": "./dist/drizzle.cjs" }
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run",
    "build": "tsdown",
    "docs:api": "typedoc --options typedoc.json",
    "docs:check": "pnpm run docs:api && tsx scripts/check-docs.ts",
    "pack:dry-run": "pnpm pack --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "tsdown": "^0.20.3",
    "typescript-eslint": "^8.46.3",
    "typedoc": "^0.28.20",
    "vitest": "4.1.12"
  }
}
